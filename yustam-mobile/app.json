{
  "expo": {
    "name": "YUSTAM Marketplace",
    "slug": "yustam-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EDE5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yustam.marketplace"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yustam.marketplace"
    },
    "scheme": "yustam",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "apiBaseUrl": "https://yustam-backend.vercel.app/api",
      "googleAuth": {
        "expoClientId": "90080814337-23s48plm9jo0o545h9m5b5c6ut8e5ami.apps.googleusercontent.com",
        "androidClientId": "90080814337-3k0s5u9pne7i5vnfgalu5sddj8uc9jj3.apps.googleusercontent.com",
        "iosClientId": "90080814337-adt11pru8ka1b5adl5q381iolbjrsj93.apps.googleusercontent.com",
        "webClientId": "90080814337-23s48plm9jo0o545h9m5b5c6ut8e5ami.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "90d55016-8f70-4e40-926d-2643f95548cd"
      }
    }
  }
